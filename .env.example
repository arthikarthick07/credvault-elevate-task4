# ---------------------------------------------------------------------------
# CredVault environment variables (copy to .env and adjust the values)
#   cp .env.example .env
# NEVER commit a real .env file or real credentials to the repository.
# ---------------------------------------------------------------------------

# HTTP port for the Express server (the built React app is served from it)
PORT=4000

# Node environment: development | production
NODE_ENV=development

# Secret used to sign admin JWTs. Use a long random string in real deployments.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Admin session lifetime (any `ms`-style duration: 30m, 8h, 1d)
JWT_EXPIRES_IN=8h

# SQLite database file (sql.js writes the whole database to this path)
DB_PATH=data/credvault.sqlite

# Initial administrator account.
# The password is hashed with bcryptjs on first startup and never stored in
# plain text. Change these values before deploying.
ADMIN_EMAIL=admin@credvault.gov
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=CredVault Administrator

# bcrypt cost factor for password hashing
BCRYPT_ROUNDS=10
