# ---------------------------------------------------------------------------
# CredVault environment variables (copy to .env and adjust the values)
#   cp .env.example .env
# NEVER commit a real .env file or real credentials to the repository.
# ---------------------------------------------------------------------------

# HTTP port for the Express server (the built React app is served from it)
PORT=4000

# Node environment: development | production
NODE_ENV=development

# Secret used to sign admin JWTs. Server-side only: never prefix it with VITE_
# and never commit it. Use at least 32 random characters (48 bytes of hex is ideal).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Admin session lifetime (any `ms`-style duration: 30m, 8h, 1d)
JWT_EXPIRES_IN=8h

# SQLite database file (sql.js writes the whole database to this path)
DB_PATH=data/credvault.sqlite

# Administrator account. Set EITHER ADMIN_PASSWORD (plain text, hashed with
# bcryptjs on startup) OR ADMIN_PASSWORD_HASH (a pre-computed bcrypt hash, which
# keeps the plain-text password out of the environment entirely).
# ADMIN_PASSWORD_HASH wins when both are present.
# Create a hash with:  npm run hash:admin
ADMIN_EMAIL=admin@credvault.gov
ADMIN_PASSWORD=change-this-admin-password
# ADMIN_PASSWORD_HASH=$2a$10$replace-with-a-real-bcrypt-hash
ADMIN_NAME=CredVault Administrator

# Changing ADMIN_PASSWORD / ADMIN_PASSWORD_HASH updates the EXISTING administrator
# account on the next server start. Old sessions stay valid until JWT_SECRET is
# rotated or they expire.

# bcrypt cost factor for password hashing
BCRYPT_ROUNDS=10
