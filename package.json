{
  "name": "credvault",
  "version": "1.0.0",
  "private": true,
  "description": "CredVault – Certificate Issuing & Verification Platform (React + Express + SQLite)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "npm --prefix client install --no-audit --no-fund --no-progress",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm --prefix client run build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix client run typecheck",
    "test": "npm run build && node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
